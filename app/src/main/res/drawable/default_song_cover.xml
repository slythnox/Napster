<?xml version="1.0" encoding="utf-8"?>
<!-- Square default cover for songs with no / broken artwork (e.g. local files
     whose album-art URI resolves to nothing). VectorDrawable (NOT a layer-list)
     because Compose painterResource only loads vector/raster assets. Gradient
     wash + centered note. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <path android:pathData="M0,0 h48 v48 h-48 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0" android:startY="0"
                android:endX="48" android:endY="48"
                android:type="linear">
                <item android:offset="0" android:color="#3A2E55" />
                <item android:offset="0.5" android:color="#4A5571" />
                <item android:offset="1" android:color="#6B8099" />
            </gradient>
        </aapt:attr>
    </path>
    <group android:translateX="12" android:translateY="12">
        <path
            android:fillColor="#E6FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M19.952 1.651a.75.75 0 0 1 .298.599V16.303a3 3 0 0 1-2.176 2.884l-1.32.377a2.553 2.553 0 1 1-1.403-4.909l2.311-.66a1.5 1.5 0 0 0 1.088-1.442V6.994l-9 2.572v9.737a3 3 0 0 1-2.176 2.884l-1.32.377a2.553 2.553 0 1 1-1.402-4.909l2.31-.66a1.5 1.5 0 0 0 1.088-1.442V5.25a.75.75 0 0 1 .544-.721l10.5-3a.75.75 0 0 1 .658.122Z" />
    </group>
</vector>
