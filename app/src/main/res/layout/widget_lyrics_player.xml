<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lyrics_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Widget.Napster">

    <!-- Card Background (Rounded rect, dark navy/black) -->
    <ImageView
        android:id="@+id/widget_lyrics_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- Split Panel: Left Artwork (with red border accent) / Right Lyrics -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Left Panel: Album Artwork or Idle Dot Note -->
        <FrameLayout
            android:id="@+id/widget_lyrics_art_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.44">

            <ImageView
                android:id="@+id/widget_lyrics_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="@string/album_art" />

            <!-- Subtly animated/static bottom-left equaliser motif on top of art -->
            <ImageView
                android:id="@+id/widget_lyrics_art_eq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Right Panel: Lyrics & Indicators -->
        <FrameLayout
            android:id="@+id/widget_lyrics_right_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.56"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Previous Lyric Line (Faded) -->
                <TextView
                    android:id="@+id/widget_lyrics_prev_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textColor="#80FFFFFF"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <!-- Active Lyric Line (Prominent White) -->
                <TextView
                    android:id="@+id/widget_lyrics_active_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp" />

                <!-- Three-Dot Indicator / Next Line -->
                <TextView
                    android:id="@+id/widget_lyrics_dots_indicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:letterSpacing="0.2"
                    android:textSize="13sp"
                    android:textColor="#55FFFFFF" />
            </LinearLayout>

            <!-- Overlay click zones for navigation: Left=prev, Center=play/pause, Right=next -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <FrameLayout
                    android:id="@+id/widget_lyrics_action_prev"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.25"
                    android:clickable="true" />

                <FrameLayout
                    android:id="@+id/widget_lyrics_action_play_pause"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.5"
                    android:clickable="true" />

                <FrameLayout
                    android:id="@+id/widget_lyrics_action_next"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.25"
                    android:clickable="true" />
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
